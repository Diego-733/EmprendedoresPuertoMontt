<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Paleta clara siempre: el sistema no debe oscurecer a la fuerza la app (Android 10+). -->
    <style name="Theme.TrabajoDeA10" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Arranque: solo mientras la app abre. MainActivity vuelve a Theme.TrabajoDeA10 antes de dibujar. -->
    <style name="Theme.TrabajoDeA10.Arranque">
        <item name="android:windowBackground">@drawable/arranque_fondo</item>
        <item name="android:statusBarColor">@color/alerce_musgo</item>
        <item name="android:navigationBarColor">@color/alerce_musgo</item>
    </style>
</resources>
