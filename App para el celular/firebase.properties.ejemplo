# Copia este archivo como firebase.properties (está en .gitignore) para activar el push.
# Son identificadores PÚBLICOS de la app Android en Firebase (Configuración del proyecto →
# Tus apps → Android, paquete com.company.ultrapp). No incluyas aquí la cuenta de servicio:
# esa solo la usa el servicio de envío (servicios/notificador) en un servidor.
firebase.appId=
firebase.apiKey=
firebase.projectId=
firebase.senderId=

# Entrega 8 (A11, App Check). Dirección de la Realtime Database del mismo proyecto
# (Compilación → Realtime Database → arriba de los datos, termina en firebasedatabase.app o firebaseio.com).
# Sin ella, la app funciona igual y la comprobación de App Check no aparece.
firebase.databaseUrl=
# El proveedor de App Check NO se configura aquí: el APK público (release) usa Play Integrity
# y el APK de prueba del equipo (debug) usa el proveedor de depuración.
