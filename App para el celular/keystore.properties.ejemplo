# Copia este archivo como keystore.properties (está en .gitignore) para firmar el APK de entrega.
# storeFile es relativo a la carpeta «App para el celular». Guarda el .jks y las contraseñas
# en un lugar seguro: sin ellos no se puede publicar una actualización con la misma firma.
storeFile=alerce-entrega.jks
storePassword=
keyAlias=alerce
keyPassword=
