# Copia este archivo como servicios/notificador/.env (está en .gitignore) y complétalo.
# No lo subas ni lo compartas por chat. Nunca uses la service_role.
SUPABASE_URL=
# Clave PÚBLICA (anon o sb_publishable_), la misma de la web.
SUPABASE_ANON_KEY=
# Cuenta propia del servicio, registrada por el administrador en la tabla notificadores.
NOTIFICADOR_EMAIL=
NOTIFICADOR_CLAVE=
# Ruta al JSON de la cuenta de servicio de Firebase (guárdalo FUERA del repositorio).
FIREBASE_CUENTA_SERVICIO_ARCHIVO=
URL_WEB=https://diego-733.github.io/EmprendedoresPuertoMontt/
